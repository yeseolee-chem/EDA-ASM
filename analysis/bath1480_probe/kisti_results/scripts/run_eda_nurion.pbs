#!/bin/bash
#PBS -V
#PBS -N tt_eda
#PBS -q normal
# ompthreads MUST equal ncpus. PBS Pro derives the job's CPU affinity from
# ompthreads, not ncpus -- with ompthreads=1 the whole job is confined to a
# single core (nproc reports 1 on a 68-core node). Same trap as the AM1 run.
#PBS -l select=1:ncpus=68:mpiprocs=1:ompthreads=68
#PBS -l walltime=48:00:00
# -A is MANDATORY on Nurion and takes an APPLICATION code, not an allocation
# code. There is no "orca" value in KISTI's vocabulary; "etc" is the catch-all.
# If the job is rejected at submit time, try "inhouse".
#PBS -A etc
#PBS -j oe
#PBS -o logs/tt_eda.pbslog
# =====================================================================
# ORCA 6.1.1 EDA-NOCV batch for the tt ([3+2] cycloaddition) subset.
#
#   cd /scratch/$USER/tt_eda_kisti_package
#   qsub scripts/run_eda_nurion.pbs                      # single node
#   qsub -v SHARD=0,NSHARD=4 scripts/run_eda_nurion.pbs  # 4-way split
#
# WHY A WORKER POOL AND NOT A PBS JOB ARRAY:
#   All 3504 eda.inp files are SERIAL -- none contains %pal/nprocs, every one
#   sets %maxcore 3500. ORCA therefore never spawns its *_mpi binaries, so no
#   OpenMPI is required at all. Nurion also allocates nodes EXCLUSIVELY, so a
#   one-reaction-per-job array would waste ~98% of each 68-core node. Running
#   many independent serial ORCA jobs on one node is the correct shape -- the
#   same conclusion the AM1 batch reached.
#
# MEMORY IS THE BINDING CONSTRAINT, NOT CORES:
#   KNL cache-mode queues (normal/long/debug) expose ~82 GB usable per node.
#   Each serial ORCA job targets %maxcore 3500 MB and can overshoot, so budget
#   ~4.5 GB. 82/4.5 ~= 18 -> default 16 workers, NOT 68.
#
# Resume-safe: a reaction whose eda.out already contains
# "ORCA TERMINATED NORMALLY" is skipped, so re-qsub after a walltime kill.
# =====================================================================

cd "$PBS_O_WORKDIR" || exit 1
mkdir -p logs

ORCA_ROOT="${ORCA_ROOT:-/home01/$USER/orca_6_1_1_linux_x86-64_shared_openmpi418_avx2}"
ORCA_BIN="$ORCA_ROOT/orca"

if [ ! -x "$ORCA_BIN" ]; then
    echo "ERROR: orca not executable at $ORCA_BIN"
    exit 1
fi

# ORCA resolves its own libs through RPATH=$ORIGIN/lib; setting LD_LIBRARY_PATH
# is belt-and-braces for the few tools that re-exec.
export LD_LIBRARY_PATH="$ORCA_ROOT/lib:${LD_LIBRARY_PATH:-}"
export PATH="$ORCA_ROOT:$PATH"
# Keep every ORCA process strictly single-threaded: the parallelism here is
# across reactions, not inside them. Without this, threaded BLAS inside N
# concurrent jobs oversubscribes the node and everything slows down.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

SHARD="${SHARD:-0}"
NSHARD="${NSHARD:-1}"
WORKERS="${WORKERS:-16}"

# Affinity guard (see the ompthreads note above).
# WORKERS_FORCE bypasses it -- needed to test the pool on a 1-core box, and as
# an escape hatch if nproc ever under-reports on a healthy node.
# ROOT CAUSE OF THE 1-WORKER BUG, DO NOT REGRESS:
# `nproc` honours OMP_NUM_THREADS. This script exports OMP_NUM_THREADS=1 above (each
# ORCA must stay single-threaded), so a plain `nproc` here returned 1 on a 68-core
# node -- the guard below then silently clamped WORKERS to 1 and every job ran ONE
# reaction at a time for hours. Use --all, which reports installed CPUs and ignores
# OMP_NUM_THREADS.  Verified: `OMP_NUM_THREADS=1 nproc` -> 1, `... nproc --all` -> 68.
ONLINE="$( nproc --all 2>/dev/null || nproc 2>/dev/null || echo 1 )"
if [ -n "${WORKERS_FORCE:-}" ]; then
    WORKERS="$WORKERS_FORCE"
    echo "NOTE: WORKERS_FORCE=$WORKERS_FORCE -- affinity guard bypassed."
elif [ "$ONLINE" -lt 8 ]; then
    echo "WARNING: only $ONLINE CPU(s) visible though ncpus=68 was requested."
    echo "         PBS has confined this job's affinity -- check that"
    echo "         ompthreads equals ncpus in the select line."
    echo "         Capping workers to $ONLINE."
    WORKERS="$ONLINE"
fi

# Node-local scratch. ORCA emits many small temporary files per job; on Lustre
# that turns into random small I/O and the processes sit in D-state (the AM1
# run measured cput/walltime = 0.69 this way). KNL nodes are diskless, so /tmp
# is tmpfs -- it consumes node RAM, which is why WORKERS is memory-bounded.
SCRATCH_ROOT="/tmp/${USER}_tteda_${PBS_JOBID:-manual}"
mkdir -p "$SCRATCH_ROOT" 2>/dev/null || SCRATCH_ROOT="/scratch/$USER/tteda_scratch/${PBS_JOBID:-manual}"
mkdir -p "$SCRATCH_ROOT"

# Heartbeat -- PBS only copies stdout back when the job ENDS, which left us blind for
# hours. Write live state to Lustre instead, once every 30 s.
#
# The stage is passed through a FILE, not a shell variable: the heartbeat runs in a
# background subshell with its own copy of the parent's variables, so assigning STAGE
# in the parent would never reach it.
JOBSHORT=$(echo "${PBS_JOBID:-manual}" | cut -d. -f1)
HB="$PBS_O_WORKDIR/logs/hb.$JOBSHORT.txt"
STAGEF="$SCRATCH_ROOT/stage"
set_stage() { echo "$1" > "$STAGEF"; }
set_stage "starting"

(
    # Self-terminating: exit as soon as the job script (our parent) is gone, so no
    # stray process is left spinning on the compute node if the trap does not fire.
    parent=$PPID
    while kill -0 "$parent" 2>/dev/null; do
        {
          echo "jobid   : ${PBS_JOBID:-manual}"
          echo "node    : $(hostname 2>/dev/null || cat /proc/sys/kernel/hostname)"
          echo "time    : $(date -Is)"
          echo "stage   : $(cat "$STAGEF" 2>/dev/null)"
          echo "workers : $WORKERS   shard $SHARD/$NSHARD"
          echo "orca procs : $(pgrep -u "$USER" -x orca 2>/dev/null | wc -l)"
          echo "load    : $(cut -d' ' -f1-3 /proc/loadavg)"
          echo "done so far: $(wc -l < "$PBS_O_WORKDIR/logs/timing.tsv" 2>/dev/null)"
          echo "scratch : $(du -sm "$SCRATCH_ROOT" 2>/dev/null | cut -f1) MB"
        } > "$HB.tmp" 2>/dev/null && mv "$HB.tmp" "$HB" 2>/dev/null
        sleep 15
    done
) &
HB_PID=$!
trap 'kill $HB_PID 2>/dev/null; rm -f "$HB.tmp"' EXIT INT TERM

echo "==== Nurion tt EDA-NOCV batch ===="
echo "node      : $(hostname 2>/dev/null || cat /proc/sys/kernel/hostname)"
echo "jobid     : ${PBS_JOBID:-<interactive>}"
echo "orca      : $ORCA_BIN"
echo "orca check: $($ORCA_BIN 2>&1 | head -1)"
echo "shard     : $SHARD / $NSHARD"
echo "workers   : $WORKERS  (cores online: $ONLINE)"
echo "bf filter : MINBF=${MINBF:-none} MAXBF=${MAXBF:-none}"
echo "scratch   : $SCRATCH_ROOT"
echo "started   : $(date -Is)"
echo

run_one() {
    rxn_dir="$1"
    rxn=$(basename "$rxn_dir")
    out="$rxn_dir/eda.out"

    if [ -f "$out" ] && grep -q "ORCA TERMINATED NORMALLY" "$out" 2>/dev/null; then
        return 0
    fi

    work="$SCRATCH_ROOT/$rxn"
    rm -rf "$work"; mkdir -p "$work" || return 1
    cp "$rxn_dir/eda.inp" "$work/eda.inp" || return 1

    # grep -c always prints a count and exits 1 when it is zero -- do NOT add
    # `|| echo 0` here, that appends a second line and corrupts timing.tsv.
    natoms=$(grep -c '^  [A-Za-z]*(' "$rxn_dir/eda.inp" 2>/dev/null)
    natoms=${natoms:-0}
    t0=$(date +%s)

    # Measure peak RSS. This is the number that decides how many workers fit on
    # a node: %maxcore 3500 is a TARGET, not a cap, and N workers that each
    # overshoot will OOM-kill the entire job. GNU time writes to its own file
    # so it does not pollute eda.err.
    TIMER=""
    [ -x /usr/bin/time ] && TIMER="/usr/bin/time -v -o $work/rss.txt"

    # ORCA must be invoked by absolute path.
    ( cd "$work" && $TIMER "$ORCA_BIN" eda.inp > eda.out 2> eda.err )

    t1=$(date +%s); dt=$((t1 - t0))
    maxrss=$(awk '/Maximum resident set size/{print int($NF/1024)}' "$work/rss.txt" 2>/dev/null)
    maxrss=${maxrss:-NA}

    # FRAGMENT SCF GATE.
    # ORCA runs three SCFs (complex + FRAG1 + FRAG2) but the main eda.out records
    # only the complex; the fragments get their own eda_frag{1,2}.out and the main
    # log shows nothing but "SPC Fragment 1 .... done (1424 sec)". A fragment SCF
    # that failed to converge would therefore pass silently -- and the resulting EDA
    # numbers would still satisfy the sum(7 channels) == Bond Energy check, because
    # that identity holds regardless of whether the densities are converged.
    # So: read the fragment outputs BEFORE the scratch dir is removed.
    fstat=""
    for k in 1 2; do
        fo="$work/eda_frag${k}.out"
        if [ ! -f "$fo" ]; then
            fstat="${fstat}f${k}=missing "
        elif grep -q "SCF NOT CONVERGED" "$fo" 2>/dev/null; then
            fstat="${fstat}f${k}=NOTCONV "
            cp "$fo" "$rxn_dir/eda_frag${k}.out" 2>/dev/null   # keep the evidence
        elif grep -q "SCF CONVERGED" "$fo" 2>/dev/null; then
            cyc=$(grep -o "SCF CONVERGED AFTER *[0-9]* CYCLES" "$fo" 2>/dev/null | grep -o "[0-9]*" | head -1)
            ech=$(grep -c "Energy Check signals convergence" "$fo" 2>/dev/null)
            fstat="${fstat}f${k}=OK:${cyc:-?}c:ec${ech:-0} "
        else
            fstat="${fstat}f${k}=unknown "
            cp "$fo" "$rxn_dir/eda_frag${k}.out" 2>/dev/null
        fi
    done
    echo "$rxn $fstat" >> "$PBS_O_WORKDIR/logs/frag_scf.tsv"
    # Complex-SCF convergence route, recorded for the same reason.
    cech=$(grep -c "Energy Check signals convergence" "$work/eda.out" 2>/dev/null)
    ccyc=$(grep -o "SCF CONVERGED AFTER *[0-9]* CYCLES" "$work/eda.out" 2>/dev/null | grep -o "[0-9]*" | head -1)
    # Peak scratch footprint. On diskless nodes /tmp is tmpfs, i.e. it eats node
    # RAM on top of maxrss -- both must fit within the node's memory.
    scrmb=$(du -sm "$work" 2>/dev/null | cut -f1)
    scrmb=${scrmb:-NA}
    frag_bad=0
    case "$fstat" in *NOTCONV*|*missing*|*unknown*) frag_bad=1;; esac
    if grep -q "ORCA TERMINATED NORMALLY" "$work/eda.out" 2>/dev/null && [ "$frag_bad" -eq 0 ]; then
        cp "$work/eda.out" "$rxn_dir/eda.out"
        [ -f "$work/eda.property.txt" ] && cp "$work/eda.property.txt" "$rxn_dir/"
        echo "OK   $rxn  atoms=$natoms  ${dt}s  rss=${maxrss}MB  scratch=${scrmb}MB"
        echo "$rxn $natoms $dt OK $maxrss $scrmb ${ccyc:-?}c ec${cech:-0}" >> "$PBS_O_WORKDIR/logs/timing.tsv"
    else
        cp "$work/eda.out" "$rxn_dir/eda.out" 2>/dev/null
        cp "$work/eda.err" "$rxn_dir/eda.err" 2>/dev/null
        echo "FAIL $rxn  atoms=$natoms  ${dt}s  rss=${maxrss}MB  scratch=${scrmb}MB  frag[$fstat]"
        echo "$rxn $natoms $dt FAIL $maxrss $scrmb ${ccyc:-?}c ec${cech:-0} $fstat" >> "$PBS_O_WORKDIR/logs/timing.tsv"
    fi
    rm -rf "$work"
}

# RXNS -- explicit reaction list, used for the pilot run. Overrides sharding.
#   qsub -v RXNS="rxn_3217 rxn_1381",WORKERS=2 scripts/run_eda_nurion.pbs
# LIMIT -- stop after this many reactions have been LAUNCHED (0 = no limit).
if [ -n "${RXNS:-}" ]; then
    TARGETS=""
    for r in $RXNS; do TARGETS="$TARGETS data/$r"; done
else
    TARGETS="$(ls -d data/rxn_* 2>/dev/null)"
fi

# MAXBF / MINBF -- split the work by basis-function count (data/nbf.tsv).
#
# WHY THIS EXISTS: on KNL the largest reactions do not fit in the 48 h
# walltime, and ORCA has no restart here -- a clipped job restarts from zero
# and would never finish. So send big reactions to SKL and the bulk to KNL:
#   KNL:  qsub -v MAXBF=1500,SHARD=i,NSHARD=48 scripts/run_eda_nurion.pbs
#   SKL:  qsub -v MINBF=1500              scripts/run_eda_nurion_skl.pbs
NBF_TSV="$PBS_O_WORKDIR/data/nbf.tsv"
# NOTE: the previous bf_of() forked one awk PER REACTION (3504 awk processes, each
# re-reading nbf.tsv from Lustre). That cost ~72 s on an idle 1-core box and far more
# on a 1.4 GHz core with sibling jobs hammering Lustre -- the job could spend a long
# time here before launching a single ORCA. Load the table ONCE into a bash array.
declare -A BF
if [ -f "$NBF_TSV" ]; then
    while read -r _r _b; do BF["$_r"]="$_b"; done < "$NBF_TSV"
fi
bf_of() { echo "${BF[$1]:-0}"; }

# Build the work list first, then hand it to xargs -P for the actual
# concurrency. The previous hand-rolled throttle used `$(jobs -pr | wc -l)`,
# which is NOT reliable across bash versions inside command substitution --
# on the compute nodes it collapsed the pool to ONE worker (measured:
# cput/walltime = 1.0 on a 68-core node). xargs -P is a standard, well-tested
# scheduler; do not replace it with a shell loop again.
i=0
launched=0
skipped_bf=0
set_stage "building worklist"
WORKLIST="$SCRATCH_ROOT/worklist.txt"
: > "$WORKLIST"
for rxn_dir in $TARGETS; do
    [ -d "$rxn_dir" ] || continue

    if [ -n "${MAXBF:-}" ] || [ -n "${MINBF:-}" ]; then
        bf=$(bf_of "$(basename "$rxn_dir")")
        if [ -n "${MAXBF:-}" ] && [ "$bf" -gt "$MAXBF" ]; then
            skipped_bf=$((skipped_bf + 1)); continue
        fi
        if [ -n "${MINBF:-}" ] && [ "$bf" -le "$MINBF" ]; then
            skipped_bf=$((skipped_bf + 1)); continue
        fi
    fi

    i=$((i + 1))
    if [ -z "${RXNS:-}" ] && [ "$NSHARD" -gt 1 ]; then
        [ $(( (i - 1) % NSHARD )) -eq "$SHARD" ] || continue
    fi
    if [ "${LIMIT:-0}" -gt 0 ] && [ "$launched" -ge "${LIMIT}" ]; then break; fi
    launched=$((launched + 1))
    echo "$rxn_dir" >> "$WORKLIST"
done

set_stage "launching"
echo "worklist  : $launched reactions (skipped by bf filter: $skipped_bf)"
echo "launching : xargs -P $WORKERS"
echo

export -f run_one
export ORCA_BIN SCRATCH_ROOT PBS_O_WORKDIR
xargs -P "$WORKERS" -I{} bash -c 'run_one "$@"' _ {} < "$WORKLIST"
set_stage "finished"


echo
echo "==== summary ===="
done_n=$(grep -l "ORCA TERMINATED NORMALLY" data/rxn_*/eda.out 2>/dev/null | wc -l)
have_n=$(ls -d data/rxn_*/eda.out 2>/dev/null | wc -l)
echo "skipped by bf filter            : $skipped_bf"
echo "reactions with eda.out          : $have_n"
echo "reactions terminated normally   : $done_n / 3504"
echo "finished : $(date -Is)"

rm -rf "$SCRATCH_ROOT"
