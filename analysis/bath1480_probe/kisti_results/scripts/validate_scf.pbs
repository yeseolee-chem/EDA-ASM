#!/bin/bash
#PBS -V
#PBS -N tt_vtscf
#PBS -q normal
#PBS -l select=1:ncpus=68:mpiprocs=1:ompthreads=68
#PBS -l walltime=24:00:00
#PBS -A etc
#PBS -j oe
#PBS -o logs/vtscf.pbslog
# =====================================================================
# SCF CONVERGENCE SENSITIVITY STUDY  (reviewer point 4)
#
# 72% of completed reactions (83/116) end with ORCA's message
#     **** Energy Check signals convergence ****
# i.e. the SCF exits on the ENERGY criterion while the density / DIIS /
# orbital-gradient criteria are still above the TightSCF thresholds.
#
# The total energy is second order in the density error, so it is fine.
# But the ETS-NOCV channels are built from the density and Fock matrices
# directly, so they are FIRST order -- and this system cancels hard:
# Pauli +237 against attractive terms leaves only -19.5 kcal/mol. A small
# density error can therefore move the individual channels much more than
# it moves the total.
#
# This job re-runs a sample of ALREADY COMPLETED reactions with
# VeryTightSCF and writes the results next to the originals so the seven
# channels can be differenced. It does NOT touch the production data.
#
#   cd /scratch/$USER/tt_eda_kisti_package
#   qsub -v NSAMPLE=20 scripts/validate_scf.pbs
#   then: python3 scripts/compare_scf.py
# =====================================================================
cd "$PBS_O_WORKDIR" || exit 1
mkdir -p logs data_vtscf

ORCA_ROOT="${ORCA_ROOT:-/home01/$USER/orca_6_1_1_linux_x86-64_shared_openmpi418_avx2}"
ORCA_BIN="$ORCA_ROOT/orca"
export LD_LIBRARY_PATH="$ORCA_ROOT/lib:${LD_LIBRARY_PATH:-}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

NSAMPLE="${NSAMPLE:-20}"
WORKERS="${WORKERS:-20}"
SCRATCH_ROOT="/tmp/${USER}_vtscf_${PBS_JOBID:-manual}"
mkdir -p "$SCRATCH_ROOT" || exit 1

# Sample completed reactions across the size range, not just the small ones:
# take every k-th completed reaction after sorting by basis-function count.
# REF_DIR = where the TightSCF results to compare against live.
# After the fragment-gate restart the old results were quarantined into
# data_unverified/, so that is the default; the inputs stay in data/.
REF_DIR="${REF_DIR:-data_unverified}"
[ -d "$REF_DIR" ] || REF_DIR=data
echo "reference (TightSCF) results : $REF_DIR"
DONE=$(grep -l "ORCA TERMINATED NORMALLY" $REF_DIR/rxn_*/eda.out 2>/dev/null \
       | sed "s|$REF_DIR/||; s|/eda.out||" | sort)
NDONE=$(echo "$DONE" | grep -c . )
echo "completed reactions available : $NDONE"
[ "$NDONE" -lt 1 ] && { echo "nothing completed yet"; exit 1; }

SAMPLE=$(for r in $DONE; do
             b=$(awk -v k="$r" '$1==k{print $2}' data/nbf.tsv)
             echo "${b:-0} $r"
         done | sort -n | awk -v n="$NSAMPLE" -v t="$NDONE" \
             'BEGIN{step=(t>n)?int(t/n):1} (NR-1)%step==0 {print $2}' | head -"$NSAMPLE")
echo "sampled: $(echo $SAMPLE | tr '\n' ' ')"

run_vt() {
    r="$1"
    mkdir -p "data_vtscf/$r"
    [ -f "data_vtscf/$r/eda.out" ] && \
        grep -q "ORCA TERMINATED NORMALLY" "data_vtscf/$r/eda.out" && return 0
    w="$SCRATCH_ROOT/$r"; rm -rf "$w"; mkdir -p "$w" || return 1
    # Only the SCF convergence keyword changes. Everything else is identical,
    # so any channel difference is attributable to convergence alone.
    sed 's/TightSCF/VeryTightSCF/g' "data/$r/eda.inp" > "$w/eda.inp"
    ( cd "$w" && "$ORCA_BIN" eda.inp > eda.out 2> eda.err )
    cp "$w/eda.out" "data_vtscf/$r/eda.out" 2>/dev/null
    grep -q "ORCA TERMINATED NORMALLY" "data_vtscf/$r/eda.out" 2>/dev/null \
        && echo "OK   $r" || echo "FAIL $r"
    rm -rf "$w"
}
export -f run_vt
export ORCA_BIN SCRATCH_ROOT

echo "$SAMPLE" | xargs -P "$WORKERS" -I{} bash -c 'run_vt "$@"' _ {}
rm -rf "$SCRATCH_ROOT"
echo "done. now run: python3 scripts/compare_scf.py"
